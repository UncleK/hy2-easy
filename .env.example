# Optional overrides for the shell and Python scripts in this project.
# Copy to .env or export selectively in your shell. Do not commit real secrets.

XRAY_SERVICE_NAME=xray
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_INSTALL_SCRIPT_URL=https://github.com/XTLS/Xray-install/raw/main/install-release.sh

NODE_CONFIG_PATH=infra/node.yaml
XRAY_TEMPLATE_PATH=infra/xray.config.template.json
RENDERED_CONFIG_PATH=rendered/config.json
V2RAYNG_URI_PATH=rendered/v2rayng-uri.txt
V2RAYNG_PROFILE_PATH=rendered/v2rayng-profile.json

XRAY_BACKUP_DIR=state/backups
XRAY_PORT=24883
XRAY_SERVER_NAME=www.cloudflare.com
XRAY_REALITY_DEST=www.cloudflare.com:443
XRAY_CLIENT_REMARK=personal-main
